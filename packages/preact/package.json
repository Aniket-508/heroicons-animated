{
  "name": "@heroicons-animated/preact",
  "version": "1.0.0",
  "description": "Beautifully animated Heroicons for Preact",
  "author": "Aniket-508",
  "license": "MIT",
  "homepage": "https://preact.heroicons-animated.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heroicons-animated/heroicons-animated.git",
    "directory": "packages/preact"
  },
  "bugs": {
    "url": "https://github.com/heroicons-animated/heroicons-animated/issues"
  },
  "keywords": ["heroicons", "preact", "icons", "animated"],
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/icons/*.d.ts",
      "import": "./dist/icons/*.js",
      "default": "./dist/icons/*.js"
    }
  },
  "typesVersions": {
    "*": {
      "*": ["./dist/icons/*.d.ts"]
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "type-check": "tsc --noEmit"
  },
  "peerDependencies": {
    "preact": "^10.0.0",
    "motion": "^11.0.0 || ^12.0.0"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "motion": "^12.0.0",
    "preact": "^10.29.8",
    "typescript": "^5.9.3",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.0.0"
  }
}
